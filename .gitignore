# Local credentials (keep the shared template)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python environments and generated caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Personal agent instructions and settings
AGENTS.md
AGENTS.local.md
AGENTS.override.md
CLAUDE.md
