# Generated collection data and runtime logs (keep repository placeholders)
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/logs/*
!/logs/.gitkeep
/_sample/
_stub/*
!_stub/.gitkeep
# Hand-off files from other roles (labels, signals, features) stay local
/files/
/signals/wf_*.parquet
/alerts/wf_20261112_PM_m9_b07_v1.parquet

# Personal PM investigations, collection runs, reviews and execution records
# Keep team experiment reports and reports/final eligible for Git.
/reports/*_PM03_sources/
/reports/*_PM17_sources/
/reports/*_PM_D01_review/
/reports/*_PM_disclosures_*/
/reports/*_PM_news_sample/
/reports/*_PM_news_naver_*/
/reports/*_PM_git_*/

# Model weights go to the team drive run_id folder; metrics.json keeps their SHA-256 (PM, 11/10).
# Exception: B RL checkpoints (reports/*/best.zip, ~0.76 MB each) are committed so the B runs can be
# replayed from git (B, 11/18). Their SHA-256 in metrics.json still identifies them.
# Do not ignore *.txt: reports/*/git_commit.txt is the R-10 record.
*.joblib
gate_*.txt
ranker_*.txt
final_gate.txt
final_ranker.txt
test.ipynb
.ipynb_checkpoints/
# B-09 탐색 (브랜치 b09-explore): 선별 체크포인트·positions·로그는 넣지 않는다. 코드·원장·결과 표만 넣는다
/explore/b09/runs/
/explore/b09/*.out.txt
